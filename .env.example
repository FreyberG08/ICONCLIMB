# =============================================================================
# AICON — Variables de entorno
# Copie este archivo a .env.local (desarrollo) o configúrelas en Vercel.
# NUNCA suba .env.local al repositorio.
# =============================================================================

# --- Supabase (si faltan, la app arranca en MODO DEMOSTRACIÓN) ---------------
# Supabase › Project Settings › API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OPCIONAL y SOLO servidor: permite invitar usuarios desde el panel.
# Nunca la anteponga con NEXT_PUBLIC_. Sin ella, invite desde el panel de Supabase.
SUPABASE_SERVICE_ROLE_KEY=

# Fuerza el modo demostración aunque existan credenciales (true/false).
ICON_DEMO_MODE=false

# --- Sitio ------------------------------------------------------------------
# URL pública definitiva (dominio propio de AICON). Se usa en SEO, sitemap y enlaces de correo.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME=AICON
NEXT_PUBLIC_DEFAULT_CURRENCY=USD

# Contacto (opcional: lo que quede vacío no se muestra; no se inventan datos)
# WhatsApp en formato internacional, solo dígitos. Ej.: 584121234567
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_BUSINESS_HOURS=

# Marca: logo oficial y fotografía del hero (rutas en /public o URLs permitidas)
# Ej.: NEXT_PUBLIC_LOGO_URL=/brand/icon-logo.svg
NEXT_PUBLIC_LOGO_URL=
NEXT_PUBLIC_HERO_IMAGE_URL=

# --- Solo MODO DEMOSTRACIÓN --------------------------------------------------
DEMO_PASSWORD=icon-demo-2026
DEMO_SESSION_SECRET=cambie-este-valor-por-uno-largo-y-aleatorio
# DEMO_DATA_DIR=.demo-data
